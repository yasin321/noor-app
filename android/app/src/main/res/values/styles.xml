<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#041511</item>
        <item name="colorPrimaryDark">#041511</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="android:windowBackground">@drawable/launch_splash</item>
        <item name="android:statusBarColor">#041511</item>
        <item name="android:navigationBarColor">#041511</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_splash</item>
    </style>
</resources>